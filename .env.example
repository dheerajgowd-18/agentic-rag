# ==============================================================================
# Enterprise Agentic RAG Environment Configuration
# ==============================================================================

# --- REASONING ENGINE (GROQ) ---
# Primary high-capacity model (e.g. openai/gpt-oss-120b)
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Guardrail & Evaluation Judge model (fast, high throughput)
GROQ_GUARD_MODEL="openai/gpt-oss-20b"

# Optional fallback key & model
GROQ_FALLBACK_API_KEY=""
GROQ_FALLBACK_MODEL="openai/gpt-oss-20b"

# Evaluation Judge key (can be same as GROQ_API_KEY or separate to isolate quotas)
JUDGE_GROQ=""

# --- LLM GATEWAY (PORTKEY) ---
PORTKEY_API_KEY=""
PORTKEY_GROQ_SLUG="rag"
PORTKEY_GROQ_SLUG_2="brag"
# Optional: saved Portkey Config ID (e.g. pc-xxx) if using Portkey UI routing
PORTKEY_CONFIG_ID=""

# --- EMBEDDINGS ---
# Options: "local" (default, zero rate limits, 384-dim) or "gemini" (3072-dim)
EMBEDDING_PROVIDER="local"
LOCAL_EMBEDDING_MODEL="all-MiniLM-L6-v2"
# Required only if EMBEDDING_PROVIDER="gemini"
GEMINI_API_KEY=""
ALLOW_EMBEDDING_FALLBACK="false"

# --- VECTOR DATABASE (QDRANT CLUSTER) ---
QDRANT_API_KEY=""
QDRANT_CLUSTER_ENDPOINT="https://your-cluster-id.region.gcp.cloud.qdrant.io:6333"
QDRANT_COLLECTION="enterprise_rag"
QDRANT_SCORE_THRESHOLD="0.30"

# --- GUARDRAILS SAFETY ---
GUARDRAILS_FAIL_CLOSED="true"

# --- SESSION PERSISTENCE ---
CHECKPOINT_PERSISTENCE="memory"
CHECKPOINT_DB_PATH="checkpoints.sqlite"

# --- SECURITY & CORS ---
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000"

# --- OBSERVABILITY & TRACING ---
# Pydantic Logfire token (optional)
LOGFIRE_TOKEN=""

# LangSmith Tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="rag_scale_test"

# --- SERVER URL ---
BACKEND_URL="http://localhost:8000"
